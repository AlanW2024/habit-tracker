# Supabase 設定 — 由 https://supabase.com/dashboard 嘅 Project Settings → API 取
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 自我使用者 ID。Migration 0001 已預先 seed 呢個 ID 入 profiles 表，唔好亂改。
NEXT_PUBLIC_SELF_USER_ID=00000000-0000-0000-0000-000000000001
